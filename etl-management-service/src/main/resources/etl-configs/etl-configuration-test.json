{
  "info": {
    "type": "etl-configuration",
    "name": "ETL / Extract Persons"
  },
  "external-datasource": {
    "type": "jdbc",
    "config": {
      "databaseType": "postgresql",
      "host": "etl-postgres-db",
      "port": 5432,
      "database": "etl",
      "user": "etl",
      "password": "etl",
      "poolSize": 2
    }
  },
  "internal-datasource": {
    "type": "jdbc",
    "config": {
      "databaseType": "postgresql",
      "host": "etl-postgres-db",
      "port": 5432,
      "database": "etl",
      "user": "etl",
      "password": "etl"
    }
  },
  "streams": {
    "data-stream-01": {
      "extract": {
        "query": {
          "text": "select id, position_name, position_code from ext.positions",
          "parameters": []
        },
        "validators": {
          "id": {
            "type": "integer",
            "required": true
          },
          "position_name": {
            "type": "varchar",
            "required": true,
            "size": 50
          },
          "position_code": {
            "type": "varchar",
            "required": true,
            "size": 50
          }
        }
      },
      "transform": {
        "jolt": [
          {
            "operation": "shift",
            "spec": {
              "id": "id",
              "position_name": "positionName",
              "position_code": "positionCode"
            }
          }
        ],
        "data-mappings": []
      },
      "load": {
        "schema": "target",
        "tables": {
          "positions": {
            "id": {
              "column": "external_id"
            },
            "positionName": {
              "column": "position_name"
            },
            "positionCode": {
              "column": "position_code"
            }
          }
        }
      }
    },
    "data-stream-02": {
      "extract": {
        "query": {
          "text": "select id, first_name, last_name from ext.persons",
          "parameters": []
        }
      }
    }
  }
}